{
  "name": "webcase",
  "productName": "Webcase",
  "version": "1.8.2",
  "description": "Startet HTML-Dateien, PDFs und mehr wie eigenständige Programme.",
  "main": "src/main.js",
  "private": true,
  "desktopName": "webcase",
  "scripts": {
    "start": "electron .",
    "icon": "node tools/make-icon.js",
    "build": "electron-builder -wlm",
    "build:win": "electron-builder -w",
    "build:linux": "electron-builder -l",
    "build:mac": "electron-builder -m"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "engines": {
    "node": ">=22.2"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "erqf1",
    "email": "erqf1@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/erqf1/webcase.git"
  },
  "build": {
    "appId": "app.webcase",
    "productName": "Webcase",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "afterPack": "tools/afterPack.js",
    "publish": {
      "provider": "github",
      "owner": "erqf1",
      "repo": "webcase"
    },
    "fileAssociations": [
      {
        "ext": "html",
        "name": "HTML-Datei",
        "description": "HTML-Datei",
        "icon": "assets/filetypes/light/html.ico",
        "role": "Viewer"
      },
      {
        "ext": "htm",
        "name": "HTM-Datei",
        "description": "HTM-Datei",
        "icon": "assets/filetypes/light/htm.ico",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "PDF-Dokument",
        "description": "PDF-Dokument",
        "icon": "assets/filetypes/light/pdf.ico",
        "role": "Viewer"
      },
      {
        "ext": "svg",
        "name": "SVG-Grafik",
        "description": "SVG-Grafik",
        "icon": "assets/filetypes/light/svg.ico",
        "role": "Viewer"
      },
      {
        "ext": "xhtml",
        "name": "XHTML-Datei",
        "description": "XHTML-Datei",
        "icon": "assets/filetypes/light/xhtml.ico",
        "role": "Viewer"
      },
      {
        "ext": "mhtml",
        "name": "Webarchiv",
        "description": "Webarchiv",
        "icon": "assets/filetypes/light/mhtml.ico",
        "role": "Viewer"
      },
      {
        "ext": "mht",
        "name": "Webarchiv",
        "description": "Webarchiv",
        "icon": "assets/filetypes/light/mhtml.ico",
        "role": "Viewer"
      },
      {
        "ext": "md",
        "name": "Markdown-Datei",
        "description": "Markdown-Datei",
        "icon": "assets/filetypes/light/md.ico",
        "role": "Viewer"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "assets/filetypes",
          "to": "filetypes",
          "filter": [
            "light/*.ico",
            "dark/*.ico"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Webcase-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Webcase-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility",
      "syncDesktopName": true,
      "synopsis": "Startet HTML-Dateien, PDFs und mehr wie eigenständige Programme",
      "artifactName": "Webcase-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "artifactName": "Webcase-${version}-amd64.${ext}"
    },
    "pacman": {
      "artifactName": "Webcase-${version}-x86_64.${ext}"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Webcase-${version}-mac-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
